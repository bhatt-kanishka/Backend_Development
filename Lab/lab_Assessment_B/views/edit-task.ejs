<!DOCTYPE html>
<html>

<head>

    <title>Edit Task</title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <link
        rel="stylesheet"
        href="/style.css">

</head>


<body>

<div class="form-container">


    <h1>✏️ Edit Task</h1>


    <form
        action="/tasks/<%= task._id %>/edit"
        method="POST"
        class="task-form">


        <label>
            Task Title
        </label>

        <input
            type="text"
            name="title"
            value="<%= task.title %>"
            required>


        <label>
            Description
        </label>

        <textarea
            name="description"><%= task.description %></textarea>


        <label>
            Due Date
        </label>

        <input
            type="date"
            name="dueDate"
            value="<%= task.dueDate
                ? new Date(task.dueDate)
                    .toISOString()
                    .split('T')[0]
                : '' %>">


        <label>
            Priority
        </label>

        <select name="priority">

            <option
                value="High"
                <%= task.priority === "High"
                    ? "selected"
                    : "" %>>

                High

            </option>


            <option
                value="Medium"
                <%= !task.priority ||
                   task.priority === "Medium"
                    ? "selected"
                    : "" %>>

                Medium

            </option>


            <option
                value="Low"
                <%= task.priority === "Low"
                    ? "selected"
                    : "" %>>

                Low

            </option>

        </select>


        <div class="checkbox-group">


            <label>

                <input
                    type="checkbox"
                    name="isUrgent"
                    <%= task.isUrgent
                        ? "checked"
                        : "" %>>

                🚨 Urgent

            </label>


            <label>

                <input
                    type="checkbox"
                    name="isImportant"
                    <%= task.isImportant
                        ? "checked"
                        : "" %>>

                ⭐ Important

            </label>

        </div>


        <div class="form-buttons">

            <button
                type="submit"
                class="btn primary">

                Save Changes

            </button>


            <a
                href="/"
                class="btn">

                Cancel

            </a>

        </div>

    </form>

</div>

</body>

</html>